# Copy to apps/api/.env — all database access uses Neon (no local DB).

# Neon pooled connection (use "Pooled connection" string from Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (use "Direct connection" string — required for Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: separate Neon branch/database for API tests (recommended)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb_test?sslmode=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb_test?sslmode=require"

JWT_SECRET="change-me-in-production"

# Comma-separated origins (include your Netlify site URL after deploy)
CORS_ORIGINS="http://localhost:5173,https://your-site.netlify.app"

# Set to "true" only on first Netlify deploy to seed demo data
RUN_SEED_ON_BUILD="false"
